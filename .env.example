# =============================================================================
# AbrigoLog - variaveis de ambiente
#
# Copie este arquivo para .env.local (desenvolvimento) e cadastre as mesmas
# variaveis em Settings -> Environment Variables na Vercel (producao).
#
# Onde encontrar: painel do Supabase -> Project Settings -> API
# =============================================================================

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave PUBLICA (publishable / anon). Pode ir para o browser - o acesso aos
# dados e controlado por Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica

# ATENCAO
# NUNCA coloque a SUPABASE_SERVICE_ROLE_KEY neste arquivo nem em qualquer
# variavel NEXT_PUBLIC_*: ela ignora o RLS e daria acesso total ao banco.
# A aplicacao nao precisa dela em nenhum ponto.
